{
  "name": "agent-sync-for-copilot",
  "displayName": "Agent Sync for Copilot",
  "description": "Synchronize persistent agent context between machines sharing a remote workspace",
  "version": "0.3.3",
  "publisher": "agent-sync",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "copilot",
    "agent",
    "sync",
    "context",
    "remote"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agent-sync/agent-sync-for-copilot"
  },
  "extensionKind": ["ui"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-sync-sidebar",
          "title": "Agent Sync for Copilot",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "agent-sync-sidebar": [
        {
          "id": "agentSyncView",
          "name": "Agent Sync"
        }
      ]
    },
    "commands": [
      {
        "command": "agentSync.initializeWorkspace",
        "title": "Initialize Workspace",
        "category": "Agent Sync",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentSync.openContext",
        "title": "Open Context",
        "category": "Agent Sync",
        "icon": "$(file-text)"
      },
      {
        "command": "agentSync.appendDecision",
        "title": "Append Decision",
        "category": "Agent Sync",
        "icon": "$(add)"
      },
      {
        "command": "agentSync.generateSummary",
        "title": "Generate Summary",
        "category": "Agent Sync",
        "icon": "$(list-ordered)"
      },
      {
        "command": "agentSync.copySummaryToClipboard",
        "title": "Copy Summary to Clipboard",
        "category": "Agent Sync",
        "icon": "$(clippy)"
      },
      {
        "command": "agentSync.syncNow",
        "title": "Sync Now",
        "category": "Agent Sync",
        "icon": "$(sync)"
      },
      {
        "command": "agentSync.viewHistory",
        "title": "View History",
        "category": "Agent Sync",
        "icon": "$(list-flat)"
      },
      {
        "command": "agentSync.refreshView",
        "title": "Refresh",
        "category": "Agent Sync",
        "icon": "$(refresh)"
      },
      {
        "command": "agentSync.configureSync",
        "title": "Configure Cloud Sync",
        "category": "Agent Sync",
        "icon": "$(gear)"
      },
      {
        "command": "agentSync.cloudPush",
        "title": "Push to Cloud",
        "category": "Agent Sync",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agentSync.cloudPull",
        "title": "Pull from Cloud",
        "category": "Agent Sync",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentSync.detectContext",
        "title": "Detect Context from Workspace",
        "category": "Agent Sync",
        "icon": "$(search)"
      },
      {
        "command": "agentSync.aiCaptureContext",
        "title": "AI Capture Context",
        "category": "Agent Sync",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentSync.syncNow",
          "when": "view == agentSyncView",
          "group": "navigation@1"
        },
        {
          "command": "agentSync.refreshView",
          "when": "view == agentSyncView",
          "group": "navigation@2"
        },
        {
          "command": "agentSync.configureSync",
          "when": "view == agentSyncView",
          "group": "navigation@3"
        },
        {
          "command": "agentSync.cloudPush",
          "when": "view == agentSyncView",
          "group": "navigation@4"
        },
        {
          "command": "agentSync.cloudPull",
          "when": "view == agentSyncView",
          "group": "navigation@5"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "agentSync.assistant",
        "name": "agent-sync",
        "description": "Query and update your agent context from Copilot Chat",
        "isSticky": false,
        "commands": [
          { "name": "capture", "description": "Let Copilot analyze the workspace and auto-generate context.md, then push to cloud" },
          { "name": "save", "description": "Save a decision or note to context.md and history.jsonl" },
          { "name": "context", "description": "Show the full contents of context.md" },
          { "name": "history", "description": "Show the last 10 entries from history.jsonl" }
        ]
      }
    ],
    "configuration": {
      "title": "Agent Sync",
      "properties": {
        "agentSync.syncToInstructions": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync summary.md into .github/copilot-instructions.md after each Generate Summary. This makes Copilot Chat aware of your project context without pasting anything."
        },
        "agentSync.cloudDataRepo": {
          "type": "string",
          "default": "agent-sync-data",
          "description": "Name of the private GitHub repository used to store sync data. Can be set on each machine so the 'Configure Cloud Sync' wizard pre-fills it. Works with any GitHub account — the token is always stored securely in the OS keychain."
        },
        "agentSync.autoGenerateSummaryOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically regenerate summary.md when context.md is saved or changed."
        },
        "agentSync.maxSummaryLines": {
          "type": "number",
          "default": 50,
          "minimum": 5,
          "maximum": 500,
          "description": "Maximum number of lines in the generated summary."
        },
        "agentSync.includeWorkspaceFiles": {
          "type": "boolean",
          "default": false,
          "description": "Include a list of tracked workspace files in the generated summary."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.3"
  }
}
